# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
frontend/node_modules/

# testing
/coverage

# next.js
/.next/
/out/
frontend/.next/
frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env.docker is SAFE TO COMMIT — shared team dev defaults
# All other .env files are secret and must NOT be committed
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
backend/__pycache__/

# SQLite (dev only — not used when running Docker)
backend/db.sqlite3
*.sqlite3

# Docker local overrides
docker-compose.override.yml

