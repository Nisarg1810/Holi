# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — Shared development environment for the 4-person team
# This file is SAFE TO COMMIT — contains only non-secret dev defaults.
# For real secrets (Twilio, SendGrid, Razorpay, AWS), create a local .env.local
# at the project root and add it to .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
JWT_SECRET=django-insecure-roman-aviation-docker-dev-key-2026

# ─── Database (PostgreSQL via Docker) ─────────────────────────────────────────
# Automatically used by config/settings.py when DATABASE_URL is set
DATABASE_URL=postgresql://aura:aura_dev_pass@db:5432/aura_dev

# ─── Redis (Celery broker via Docker) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Email (console backend in dev — OTPs printed to Django terminal logs) ────
# Leave empty to use Django's console email backend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ─── AWS S3 (leave empty to disable file upload in dev) ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# ─── Payment Gateway (leave empty to skip payments in dev) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Twilio (leave empty to disable SMS OTP in dev) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
